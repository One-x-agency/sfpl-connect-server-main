

# Server Details
NODE_ENV=dev # dev, prod
SERVICE_NAME=service_name
SERVER_PORT=3007

# JWT
JWT_SECRET=example&token_#123

# Database URL
# Example: postgres://<username>:<password>@<host>:<port>/<database>?sslmode=disable
DATABASE_URL="postgres://postgres:1234567890@localhost:5432/voosto?sslmode=disable"

# Device log cold storage — dedicated bucket. Reuses AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION from above.
# Run: npm run archive-device-logs  (or bash command/archive-device-logs-to-s3.sh)
# Requires: Node + npm install; uses @aws-sdk/client-s3 (no aws CLI)
# S3 path: {prefix}/{imei}-{sanitized-name}/{YYYY-MM}_{imei}.csv.zip
DEVICE_LOG_ARCHIVE_S3_BUCKET=your-archive-only-bucket
# AWS_REGION=ap-south-1
# DEVICE_LOG_ARCHIVE_S3_PREFIX=device-logs-archive
# DEVICE_LOG_ARCHIVE_KEEP_MONTHS=3
# DEVICE_LOG_ARCHIVE_TZ=Asia/Kolkata
# DEVICE_LOG_ARCHIVE_DRY_RUN=0
# DEVICE_LOG_ARCHIVE_FORCE_REEXPORT=0
# DEVICE_LOG_ARCHIVE_DELETE_BATCH=10000
# DEVICE_LOG_ARCHIVE_S3_RETRIES=3

# Mirror archive zips into AWS_S3_BACKUP_BUCKET (e.g. sfpl-backup), same as DB/file backups.
# Dest path: csv_backup/{database}_{YYYY-MM-DD_HH-mm-ss}/…  (keep latest 5 per database)
# Requires AWS_S3_BACKUP_BUCKET. Run: npm run backup-device-log-archive
# DEVICE_LOG_ARCHIVE_BACKUP_S3_KEY=csv_backup
# DEVICE_LOG_ARCHIVE_BACKUP_RETENTION_COUNT=5
# DEVICE_LOG_ARCHIVE_BACKUP_DRY_RUN=0
# DEVICE_LOG_ARCHIVE_BACKUP_FORCE_RECOPY=0
# DEVICE_LOG_ARCHIVE_BACKUP_COPY_RETRIES=3
# DEVICE_LOG_ARCHIVE_BACKUP_LIST_PAGE_SIZE=500

# Logger Config
# precedence of levels: block:-1, error:0, warn:1, info:2, http:3, verbose:4, debug:5, silly:6
# disable logs with level "block"
CONSOLE_LOG_LEVEL=debug # false, error, warn, info, http, verbose, debug, silly
FILE_LOG_LEVEL=error # false, error, warn, info, http, verbose, debug, silly

# MQTT broker (device telemetry)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=

# EMQX dashboard API — required for device online status (is_online)
# Create an API key in EMQX Dashboard → Access Control → API Keys
EMQX_API_KEY=
EMQX_API_SECRET=
# EMQX_API_PORT=18083

# SFTP
SMTP_HOST=smtp.xyz.com
SMTP_PORT=465
SMTP_USER=abc@xyz.com
SMTP_PASSWORD=123234

# Razorpay (connect store checkout)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# SFPL website chatbot (OpenAI + shared secret with sfpl-web)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
WEB_CHAT_SECRET=
# OPENAI_MAX_OUTPUT_TOKENS=450
# OPENAI_MAX_CONTEXT_CHARS=3200
# OPENAI_TOP_K=3
# OPENAI_MIN_RETRIEVAL_SCORE=1.2
# OPENAI_TIMEOUT_MS=20000
# OPENAI_RATE_LIMIT_MAX=20
# OPENAI_RATE_LIMIT_WINDOW_MS=60000
# OPENAI_CACHE_TTL_SECONDS=86400

